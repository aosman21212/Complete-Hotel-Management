<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== HOTEL TRANSPORT LOCATION LIST ==================== -->
    <record id="view_hotel_transport_location_list" model="ir.ui.view">
        <field name="name">hotel.transport.location.list</field>
        <field name="model">hotel.transport.location</field>
        <field name="arch" type="xml">
            <list string="Transport Locations">
                <field name="name"/>
                <field name="address"/>
                <field name="distance_km"/>
                <field name="price_per_km"/>
            </list>
        </field>
    </record>

    <!-- ==================== HOTEL TRANSPORT LOCATION FORM ==================== -->
    <record id="view_hotel_transport_location_form" model="ir.ui.view">
        <field name="name">hotel.transport.location.form</field>
        <field name="model">hotel.transport.location</field>
        <field name="arch" type="xml">
            <form string="Transport Location">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="address"/>
                        </group>
                        <group>
                            <field name="distance_km"/>
                            <field name="price_per_km"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hotel_transport_location" model="ir.actions.act_window">
        <field name="name">Transport Locations</field>
        <field name="res_model">hotel.transport.location</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== HOTEL TRANSPORT REQUEST LIST ==================== -->
    <record id="view_hotel_transport_request_list" model="ir.ui.view">
        <field name="name">hotel.transport.request.list</field>
        <field name="model">hotel.transport.request</field>
        <field name="arch" type="xml">
            <list string="Transport Requests">
                <field name="name"/>
                <field name="pickup_datetime"/>
                <field name="booking_id"/>
                <field name="guest_name"/>
                <field name="trip_type"/>
                <field name="pickup_location_id"/>
                <field name="drop_location_id"/>
                <field name="vehicle_type"/>
                <field name="distance_km"/>
                <field name="charge"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- ==================== HOTEL TRANSPORT REQUEST FORM ==================== -->
    <record id="view_hotel_transport_request_form" model="ir.ui.view">
        <field name="name">hotel.transport.request.form</field>
        <field name="model">hotel.transport.request</field>
        <field name="arch" type="xml">
            <form string="Transport Request">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            invisible="state != 'draft'"
                            class="btn-primary"/>
                    <button name="action_start" string="Start Trip" type="object"
                            invisible="state != 'confirmed'"
                            class="btn-primary"/>
                    <button name="action_complete" string="Complete" type="object"
                            invisible="state != 'in_progress'"
                            class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state == 'completed' or state == 'cancelled'"
                            class="btn-danger"/>
                    <button name="action_print_driver_slip" string="Print Driver Slip" type="object"
                            class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,in_progress,completed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Request Info">
                            <field name="name" readonly="1"/>
                            <field name="booking_id"/>
                            <field name="folio_id"/>
                        </group>
                        <group string="Guest Info">
                            <field name="guest_name"/>
                            <field name="phone"/>
                        </group>
                    </group>
                    <group>
                        <group string="Trip Details">
                            <field name="trip_type"/>
                            <field name="pickup_datetime"/>
                            <field name="vehicle_type"/>
                        </group>
                        <group string="Locations">
                            <field name="pickup_location_id"/>
                            <field name="drop_location_id"/>
                            <field name="distance_km"/>
                            <field name="charge"/>
                        </group>
                    </group>
                    <group string="Driver Details">
                        <group>
                            <field name="driver_name"/>
                            <field name="driver_phone"/>
                        </group>
                    </group>
                    <separator string="Notes"/>
                    <field name="notes" nolabel="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ==================== HOTEL TRANSPORT REQUEST SEARCH ==================== -->
    <record id="view_hotel_transport_request_search" model="ir.ui.view">
        <field name="name">hotel.transport.request.search</field>
        <field name="model">hotel.transport.request</field>
        <field name="arch" type="xml">
            <search string="Search Transport Requests">
                <field name="name"/>
                <field name="booking_id"/>
                <field name="guest_name"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Pickup" name="pickup" domain="[('trip_type', '=', 'pickup')]"/>
                <filter string="Drop" name="drop" domain="[('trip_type', '=', 'drop')]"/>
                <filter string="Round Trip" name="round" domain="[('trip_type', '=', 'round')]"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Trip Type" name="group_trip_type" context="{'group_by': 'trip_type'}"/>
                    <filter string="Vehicle" name="group_vehicle" context="{'group_by': 'vehicle_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_hotel_transport_request" model="ir.actions.act_window">
        <field name="name">Transport Requests</field>
        <field name="res_model">hotel.transport.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hotel_transport_request_search"/>
    </record>

</odoo>
