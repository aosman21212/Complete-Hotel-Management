<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_hotel_booking" model="ir.sequence">
            <field name="name">Hotel Booking</field>
            <field name="code">hotel.booking</field>
            <field name="prefix">BK/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>

        <record id="seq_hotel_folio" model="ir.sequence">
            <field name="name">Hotel Folio</field>
            <field name="code">hotel.folio</field>
            <field name="prefix">FO/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>

        <record id="seq_hotel_laundry" model="ir.sequence">
            <field name="name">Hotel Laundry Order</field>
            <field name="code">hotel.laundry.order</field>
            <field name="prefix">LD/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>

        <record id="seq_hotel_restaurant" model="ir.sequence">
            <field name="name">Hotel Restaurant Order</field>
            <field name="code">hotel.restaurant.order</field>
            <field name="prefix">RS/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>

        <record id="seq_hotel_transport" model="ir.sequence">
            <field name="name">Hotel Transport Request</field>
            <field name="code">hotel.transport.request</field>
            <field name="prefix">TR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>

    </data>
</odoo>
