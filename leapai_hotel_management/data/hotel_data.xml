<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Document Types -->
        <record id="document_type_passport" model="hotel.document.type">
            <field name="name">Passport</field>
            <field name="description">International travel passport</field>
            <field name="active">True</field>
        </record>

        <record id="document_type_national_id" model="hotel.document.type">
            <field name="name">National ID</field>
            <field name="description">Government-issued national identity card</field>
            <field name="active">True</field>
        </record>

        <record id="document_type_driver_license" model="hotel.document.type">
            <field name="name">Driver License</field>
            <field name="description">Government-issued driver license</field>
            <field name="active">True</field>
        </record>

        <!-- Room Facilities -->
        <record id="facility_wifi" model="hotel.room.facility">
            <field name="name">WiFi</field>
            <field name="icon">fa-wifi</field>
        </record>

        <record id="facility_tv" model="hotel.room.facility">
            <field name="name">TV</field>
            <field name="icon">fa-television</field>
        </record>

        <record id="facility_ac" model="hotel.room.facility">
            <field name="name">Air Conditioning</field>
            <field name="icon">fa-snowflake-o</field>
        </record>

        <!-- Floors -->
        <record id="floor_ground" model="hotel.floor">
            <field name="name">Ground Floor</field>
            <field name="sequence">1</field>
            <field name="active">True</field>
        </record>

        <record id="floor_first" model="hotel.floor">
            <field name="name">First Floor</field>
            <field name="sequence">2</field>
            <field name="active">True</field>
        </record>

        <!-- Room Types -->
        <record id="room_type_standard" model="hotel.room.type">
            <field name="name">Standard Room</field>
            <field name="description">Comfortable standard room with essential amenities</field>
            <field name="capacity_adults">2</field>
            <field name="capacity_children">1</field>
            <field name="base_price">100.00</field>
            <field name="active">True</field>
        </record>

        <record id="room_type_deluxe" model="hotel.room.type">
            <field name="name">Deluxe Suite</field>
            <field name="description">Spacious deluxe suite with premium amenities and city view</field>
            <field name="capacity_adults">2</field>
            <field name="capacity_children">2</field>
            <field name="base_price">250.00</field>
            <field name="active">True</field>
        </record>

        <!-- Transport Locations -->
        <record id="transport_location_airport" model="hotel.transport.location">
            <field name="name">International Airport</field>
            <field name="address">Airport Road, Terminal 1</field>
            <field name="distance_km">25.0</field>
            <field name="price_per_km">2.5</field>
        </record>

        <record id="transport_location_station" model="hotel.transport.location">
            <field name="name">Central Railway Station</field>
            <field name="address">Station Road, Central District</field>
            <field name="distance_km">10.0</field>
            <field name="price_per_km">2.0</field>
        </record>

    </data>
</odoo>
