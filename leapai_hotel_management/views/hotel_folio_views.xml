<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== HOTEL FOLIO LIST ==================== -->
    <record id="view_hotel_folio_list" model="ir.ui.view">
        <field name="name">hotel.folio.list</field>
        <field name="model">hotel.folio</field>
        <field name="arch" type="xml">
            <list string="Folios" decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="guest_name"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="total_amount"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- ==================== HOTEL FOLIO FORM ==================== -->
    <record id="view_hotel_folio_form" model="ir.ui.view">
        <field name="name">hotel.folio.form</field>
        <field name="model">hotel.folio</field>
        <field name="arch" type="xml">
            <form string="Hotel Folio">
                <header>
                    <button name="action_close" string="Close Folio" type="object"
                            invisible="state != 'open'"
                            class="btn-primary"/>
                    <button name="action_reopen" string="Re-Open" type="object"
                            invisible="state != 'closed'"
                            class="btn-secondary"/>
                    <button name="action_print_invoice" string="Print Invoice" type="object"
                            class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,closed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Folio Info">
                            <field name="name" readonly="1"/>
                            <field name="booking_id"/>
                        </group>
                        <group string="Guest Info">
                            <field name="guest_name"/>
                            <field name="check_in"/>
                            <field name="check_out"/>
                        </group>
                    </group>
                    <separator string="Charges"/>
                    <field name="line_ids">
                        <list editable="bottom" default_group_by="category">
                            <field name="date"/>
                            <field name="category"/>
                            <field name="description"/>
                            <field name="reference" optional="hide"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="amount"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="total_amount" widget="monetary"/>
                    </group>
                    <separator string="Notes"/>
                    <field name="notes" nolabel="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ==================== HOTEL FOLIO SEARCH ==================== -->
    <record id="view_hotel_folio_search" model="ir.ui.view">
        <field name="name">hotel.folio.search</field>
        <field name="model">hotel.folio</field>
        <field name="arch" type="xml">
            <search string="Search Folios">
                <field name="name"/>
                <field name="guest_name"/>
                <field name="booking_id"/>
                <filter string="Open" name="open" domain="[('state', '=', 'open')]"/>
                <filter string="Closed" name="closed" domain="[('state', '=', 'closed')]"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Check-In" name="group_checkin" context="{'group_by': 'check_in'}"/>
            </search>
        </field>
    </record>

    <record id="action_hotel_folio" model="ir.actions.act_window">
        <field name="name">Folios</field>
        <field name="res_model">hotel.folio</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hotel_folio_search"/>
    </record>

</odoo>
