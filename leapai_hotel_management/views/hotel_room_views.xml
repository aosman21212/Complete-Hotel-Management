<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== HOTEL ROOM KANBAN ==================== -->
    <record id="view_hotel_room_kanban" model="ir.ui.view">
        <field name="name">hotel.room.kanban</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" default_group_by="floor_id">
                <field name="name"/>
                <field name="floor_id"/>
                <field name="room_type_id"/>
                <field name="status"/>
                <field name="facility_ids"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="o_kanban_record_body">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle text-muted">
                                    <field name="room_type_id"/>
                                </div>
                                <div class="mt-2">
                                    <t t-if="record.status.raw_value == 'vacant'">
                                        <span class="badge text-bg-success">Vacant</span>
                                    </t>
                                    <t t-elif="record.status.raw_value == 'reserved'">
                                        <span class="badge text-bg-warning">Reserved</span>
                                    </t>
                                    <t t-elif="record.status.raw_value == 'occupied'">
                                        <span class="badge text-bg-danger">Occupied</span>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ==================== HOTEL ROOM LIST ==================== -->
    <record id="view_hotel_room_list" model="ir.ui.view">
        <field name="name">hotel.room.list</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <list string="Rooms">
                <field name="name"/>
                <field name="floor_id"/>
                <field name="room_type_id"/>
                <field name="status" decoration-success="status == 'vacant'" decoration-warning="status == 'reserved'" decoration-danger="status == 'occupied'"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ==================== HOTEL ROOM FORM ==================== -->
    <record id="view_hotel_room_form" model="ir.ui.view">
        <field name="name">hotel.room.form</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <form string="Hotel Room">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="floor_id"/>
                            <field name="room_type_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="status" widget="badge"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Facilities">
                            <field name="facility_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Images">
                            <field name="image_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="image" widget="image" options="{'size': [128, 128]}"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="description" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ==================== HOTEL ROOM SEARCH ==================== -->
    <record id="view_hotel_room_search" model="ir.ui.view">
        <field name="name">hotel.room.search</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <search string="Search Rooms">
                <field name="name"/>
                <field name="floor_id"/>
                <field name="room_type_id"/>
                <filter string="Vacant" name="vacant" domain="[('status', '=', 'vacant')]"/>
                <filter string="Reserved" name="reserved" domain="[('status', '=', 'reserved')]"/>
                <filter string="Occupied" name="occupied" domain="[('status', '=', 'occupied')]"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Floor" name="group_floor" context="{'group_by': 'floor_id'}"/>
                    <filter string="Room Type" name="group_type" context="{'group_by': 'room_type_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
            </search>
        </field>
    </record>

    <record id="action_hotel_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_hotel_room_search"/>
    </record>

</odoo>
